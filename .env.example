VITE_GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
VITE_KAMO_GAS_URL=
# Googleログイン用のOAuthクライアントID（公開されても問題ない値。全アプリ共通）
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
# ※ VITE_API_TOKEN は廃止。秘密の値を VITE_ で始まる変数に入れないこと（ビルドで公開JSに埋め込まれる）

# tools/tm.cjs（CLI）用。GAS のスクリプトプロパティ SERVICE_TOKEN と同じ値を .env.local に書く。
# VITE_ で始めないこと（フロントには入れない）
TM_SERVICE_TOKEN=
